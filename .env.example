APP_NAME=AppInventory
PORT=8080
DEBUG=true
LIMIT=10
PATH_LOGGING=./logs/

# Database Configuration (PostgreSQL)
DATABASE_NAME=inventory_management
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_MAX_CONN=10

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_2026
JWT_EXPIRY_MINUTES=1440

# Redis Cache Configuration (Optional - Set REDIS_ENABLED=false if Redis is not running)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
